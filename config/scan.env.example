# RouterScan runtime configuration example.
# Copy to an operator-controlled environment; do not commit real secrets.

# Explicitly authorized target policy. Production jobs should require an
# externally supplied allowlist/authorization reference.
SCAN_AUTHORIZATION_REQUIRED=1
SCAN_AUTHORIZATION_REF=

# Runtime limits. Values are intentionally conservative defaults.
SCAN_BATCH_SIZE=10000
SCAN_CONCURRENCY=100
SCAN_MAX_CONCURRENCY=500
SCAN_TIMEOUT=2.0

# Network scope is supplied by the operator/job and is never inferred from
# scan results. Keep credentials and tokens outside this file.
SCAN_TARGETS_FILE=
SCAN_AGENT_ID=
SCAN_MACHINE_ID=

# Automated public-data sync must use an explicitly configured non-main branch.
# Example: sync/public. Never set this to main or master.
SCAN_SYNC_BRANCH=
